NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://syncflow:syncflow@localhost:5432/syncflow?schema=public
DATABASE_URL_TEST=postgresql://syncflow:syncflow@localhost:5432/syncflow_test?schema=public
AUTH_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_HOURS=168
INVITATION_TOKEN_SECRET=replace-with-a-third-32-character-secret
INVITATION_TTL_HOURS=168
WEB_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=SyncFlow <no-reply@syncflow.local>
# Set to a shared parent domain such as .example.com in production.
COOKIE_DOMAIN=
