NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Runtime database connection. This can be local PostgreSQL or a Supabase
# session-pooler URL ending in port 5432 with sslmode=require.
DATABASE_URL=postgresql://syncflow:syncflow@localhost:5432/syncflow?schema=public
# Set true only when local certificate trust prevents the pg-based Prisma
# adapter from connecting to a hosted database such as Supabase.
DATABASE_USE_LIBPQ_SSL_COMPAT=false
# Optional migration connection. Leave empty to reuse DATABASE_URL. For
# Supabase, use a direct connection when IPv6 is available or the session
# pooler on port 5432; do not use the transaction pooler for migrations.
DIRECT_URL=
# Keep integration tests on a separate local PostgreSQL database.
DATABASE_URL_TEST=postgresql://syncflow:syncflow@localhost:5432/syncflow_test?schema=public
# Hosted poolers can need longer than Prisma's two-second transaction max wait.
DATABASE_TRANSACTION_MAX_WAIT_MS=15000
DATABASE_TRANSACTION_TIMEOUT_MS=15000
AUTH_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_HOURS=168
INVITATION_TOKEN_SECRET=replace-with-a-third-32-character-secret
INVITATION_TTL_HOURS=168
WEB_URL=http://localhost:3000
# Use smtp for local Mailpit delivery or brevo for the Brevo transactional API.
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=SyncFlow <no-reply@syncflow.local>
MAIL_FROM_EMAIL=no-reply@syncflow.local
MAIL_FROM_NAME=SyncFlow
# Required only when MAIL_PROVIDER=brevo. Never expose this to the web app.
BREVO_API_KEY=
# Set to a shared parent domain such as .example.com in production.
COOKIE_DOMAIN=
